# SatQuery AI Environment Configuration
# Copy to .env and fill in values

# Server
SATQUERY_HOST=0.0.0.0
SATQUERY_PORT=8000
SATQUERY_DEBUG=true
SATQUERY_LOG_LEVEL=INFO

# Model Configuration
SATQUERY_MODEL_BACKEND=mock  # Options: mock, cached, real
SATQUERY_VLM_MODEL=qwen2-vl-2b
SATQUERY_DEVICE=cpu  # Options: cpu, cuda, cuda:0
SATQUERY_MODEL_CACHE_DIR=./data/models

# Upload Limits
SATQUERY_MAX_UPLOAD_SIZE_MB=100
SATQUERY_ALLOWED_EXTENSIONS=tif,tiff,png,jpg,jpeg

# Demo Mode
SATQUERY_DEMO_MODE=false
SATQUERY_DEMO_DATA_DIR=./data/demo

# Paths
SATQUERY_OUTPUT_DIR=./outputs
SATQUERY_CONFIG_PATH=./configs/default.yaml
